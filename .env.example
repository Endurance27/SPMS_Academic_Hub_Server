# App Configuration
APP_NAME=SPMS Academic Hub
APP_ENV=development
DEBUG=true
API_VERSION=v1
SECRET_KEY=change-this-secret-key-in-production
DB_AUTO_CREATE_TABLES=true
COMPOSE_PROJECT_NAME=spms-academic-hub

# Database
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_pass
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://app_user:app_pass@postgres:5432/app_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass
REDIS_DB=0
REDIS_URL=redis://:redis_pass@redis:6379/0

# Celery
CELERY_BROKER_URL=redis://:redis_pass@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_pass@redis:6379/0

# Security / JWT
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# 2FA (Twilio - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRE_MINUTES=5

# External APIs
GOOGLE_MAPS_API_KEY=

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOGSTASH_HOST=
LOGSTASH_PORT=5000

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Mailtrap
MAILTRAP_API_KEY=
MAILTRAP_SENDER_EMAIL=no-reply@example.com
MAILTRAP_SENDER_NAME=SPMS Academic Hub

# Email / Third-party (Legacy)
SENDGRID_API_KEY=

# Documentation Auth (Optional)
DOCS_USERNAME=
DOCS_PASSWORD=

# API / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Support
SUPPORT_EMAIL=support@example.com

# GitHub Container Registry (for production)
GITHUB_USERNAME=your-github-username
GIT_PERSONAL_ACCESS_TOKEN=your-pat-with-write-packages-scope
BUILD_IMAGE=spms-academic-hub
BUILD_TAG=latest
